/**
 * The API Worker.
 *
 * Two things are worth knowing before editing this file.
 *
 * **A named environment inherits less than it looks.** Wrangler 4 inherits
 * `name`, `main`, `routes`, `triggers` and the `compatibility_*` keys into an
 * `env.*` block, but **not** `vars`, `d1_databases`, `r2_buckets`, `queues` or
 * `services`. Any environment added here must redeclare each of those in full,
 * or it deploys with the binding silently missing.
 *
 * **This file is the deployed configuration, and only that.** A developer's
 * machine and the end-to-end suite run on `wrangler.dev.jsonc` instead, because
 * two things here cannot be shared with them: the `vars` below say this is
 * production, and there is no `STORAGE` binding to give them. That file explains
 * both. Anything added here that local work also needs has to be added there
 * too — nothing makes the two agree by construction.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seb-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",

  // Pinned so a stray CLOUDFLARE_ACCOUNT_ID in the environment cannot redirect
  // a deploy to a different account. That is not hypothetical: it happened once
  // while this environment was being set up, and sent a read to the wrong
  // account entirely. An account id is an identifier, not a credential.
  "account_id": "15a26eaa33db8561da8f42e036dfe627",

  // Workers Logs. Sampling is left at 1 because the traffic is a programme
  // office's, not a consumer product's, and a dropped log during an intake
  // problem is worth more than the storage it saves.
  //
  // What reaches these logs is a standing constraint, not a preference: never
  // a one-time code, a message body, a full recipient address, a provider
  // token, or a document object key.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.graphql"],
      "fallthrough": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  // Rate limiting. One binding per allowance, because the platform's limiter
  // takes its limit and period from configuration rather than from the call.
  //
  // **The period may only be 10 or 60 seconds.** That is the platform's
  // constraint, not a choice, and it is why the allowances here are per minute
  // — see src/services/rate-limit/README.md for what that costs and what the
  // policy does about it.
  //
  // A named environment would have to redeclare every one of these, for the
  // reason at the top of this file. Missing here, the limiter fails closed and
  // refuses whatever the policy names.
  "ratelimits": [
    { "name": "RL_REQUEST_IP", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_SIGN_IN_SUBJECT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SIGN_IN_IP", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_SIGNUP_SUBJECT", "namespace_id": "1004", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_SIGNUP_IP", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_VERIFY_IP", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_INVITE_IP", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_UPLOAD_SESSION", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_RESET_SUBJECT", "namespace_id": "1009", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_RESET_IP", "namespace_id": "1010", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_RESET_VERIFY_IP", "namespace_id": "1011", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PASSWORD_SESSION", "namespace_id": "1012", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_EMAIL_CHANGE_SESSION", "namespace_id": "1013", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_EMAIL_VERIFY_SESSION", "namespace_id": "1014", "simple": { "limit": 10, "period": 60 } }
  ],
  // Non-secret configuration. Credentials are never here — they are set with
  // `wrangler secret put`, which keeps them out of a public repository.
  //
  // FRONTEND_ORIGINS is "*", which echoes whichever origin asks rather than
  // sending a literal `*` (a browser refuses that on a credentialed request).
  // It means any site can call this API as a signed-in user, and it is here
  // because the frontend host is not yet known. Name the origin before launch.
  //
  // These are the *deployed* values, and nothing else reads them: local work and
  // the end-to-end suite run on `wrangler.dev.jsonc`, which declares no `vars`
  // at all, so `ENVIRONMENT` reads as local there.
  //
  // That is load-bearing. Give the dev config a `vars` block naming a deployed
  // environment and storage would point at the real provider.
  //
  // `ENVIRONMENT` is `develop`, and the difference from `production` is exactly
  // one seam: malware scanning. `document-scanner` refuses to build without a
  // real scanner in production, and there is none — so every uploaded document
  // stayed PENDING and could never be opened. Under `develop` it builds the
  // permissive scanner instead, which is what that file says `develop` is for:
  // a demonstration environment holding no real applicant's evidence.
  //
  // Nothing else weakens. Notifications still deliver through Pingram
  // (`develop` is a delivering environment), storage is still Cloudinary, the
  // queue is still the real one, and rate limiting still counts on the bindings
  // above — `RATE_LIMIT_DISABLED` is not set, and setting it here would turn
  // counting off, because only production refuses it outright.
  //
  // **This must go back to `production` before real applications arrive.**
  // Scanning is what is being given up, and it stops being optional the moment
  // the evidence is somebody's.
  "vars": {
    "ENVIRONMENT": "develop",
    "FRONTEND_ORIGINS": "*",
    // Where the client is. An invitation link travels to a person, so it has to
    // land on the portal — unset, this falls back to this Worker's own origin,
    // which has no page to receive the token in its fragment.
    "PORTAL_BASE_URL": "https://seb-web.kuchukboromd-15a.workers.dev",
    "STORAGE_TRANSPORT": "cloudinary",
    "PINGRAM_NOTIFICATION_TYPE": "seb",
    "PINGRAM_BASE_URL": "https://api.eu.pingram.io",
    "PINGRAM_FROM_NAME": "Mission SEP",
    "PINGRAM_FROM_ADDRESS": "noreply@pingram.io"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seb-backend",
      "database_id": "3be23488-48c3-43a7-b561-5037a521daf2"
    }
  ],
  // No `r2_buckets` here. R2 is not enabled on this account, and `wrangler
  // deploy` checks the bucket exists — a dry run does not, so this fails only
  // at the real deploy. Deployed storage is Cloudinary and never touches the
  // binding. Local work and the end-to-end suite do need it, and get it from
  // `wrangler.dev.jsonc`.

  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "seb-backend-queue"
      }
    ],
    "consumers": [
      {
        "queue": "seb-backend-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        /*
         * One invocation at a time, because the scanner behind this is.
         * Cloudflare autoscales consumers by backlog, and Cloudmersive's free
         * tier allows a single concurrent request — so scaling up would have
         * the consumers rate-limit each other, and every 429 costs a retry
         * from the same small monthly allowance that the scan itself does.
         */
        "max_concurrency": 1,
        /*
         * Retries exist for a provider that was briefly unavailable, not for a
         * misconfiguration. Three attempts distinguish the two: a transient
         * failure clears, and a missing key does not — it lands in the
         * dead-letter queue, where the document is recoverable and countable.
         *
         * Without the dead letter queue an exhausted message is dropped, and
         * that is the quiet failure worth spending a queue on: the document
         * stays PENDING and unopenable for good, with nothing but a log line
         * to say it ever happened.
         */
        "max_retries": 3,
        "dead_letter_queue": "seb-backend-queue-dlq"
      }
    ]
  }
}
