# Local configuration for the Worker. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# Wrangler loads `.env` then `.env.local`, with the later winning, so put
# anything personal in `.env.local`. Both are gitignored; this file is the only
# one checked in and must never hold a real value.
#
# One trap worth knowing: **`.dev.vars` wins over all of these.** Wrangler reads
# it first and, if it exists, ignores `.env` and `.env.local` entirely. If a
# change here seems to have no effect, look for a leftover `.dev.vars`.
#
# Deployed environments take none of this from a file — secrets are provisioned
# with `wrangler secret put`.

# --- Required ---------------------------------------------------------------

# Keys the HMAC domains for signup challenges, one-time codes and sessions.
# At least 32 bytes.
AUTH_SECRET = ""

# Keys the digest of the identity and bank numbers a reviewer transcribes during
# a desk review. At least 32 bytes.
#
# Deliberately not AUTH_SECRET: rotating session signing must never silently
# stop the duplicate check matching what is already recorded. And it is
# effectively set once — every stored digest was made with it, so a new value
# stops matching everything recorded under the old one, and the check would then
# pass everything, quietly.
#
# It is read at first use rather than at startup, so a deployment missing it
# looks healthy until the first desk review is completed, which then fails.
IDENTIFIER_SECRET = ""

# Seals role invitations, which are bearer credentials that live only in a
# link and are never written to the database. At least 32 bytes.
#
# Separate from AUTH_SECRET again, and for a sharper reason than
# IDENTIFIER_SECRET: rotating this must invalidate every outstanding invitation
# without touching anybody's session. That is a recoverable action — the
# invitations are simply reissued — and it is the lever to pull if one leaks.
ROLE_INVITE_SECRET = ""

# --- Ordinary configuration -------------------------------------------------

# What this environment is. Two seams read it, and both treat unset the same as
# "local", because an unconfigured machine is a developer's — a deployed
# environment is always told what it is.
#
#   unset / "local"   documents are kept by the Worker itself; one-time codes
#                     are printed to the log instead of being delivered
#   "develop"         documents go to the bucket; codes are really sent
#   "production"      same, against production resources
#
# Setting this to anything but local on your own machine makes both seams demand
# real credentials and refuse without them. That refusal is deliberate: a
# deployed environment that cannot do the real thing must say so rather than
# quietly do something else.
ENVIRONMENT = "local"

# Comma-separated credentialed-CORS allowlist.
#
# Most of the client's traffic goes through its own server-side layer, which no
# browser origin check applies to. One thing does not: uploading a document is
# performed by the browser itself, to the storage origin rather than to the page
# it is on. So the client's origin has to be listed here or the upload's
# preflight is refused and the file never leaves the page.
#
# For the client's own `npm run local`, that is http://localhost:9990. The
# end-to-end suite sets its own on the command line rather than depending on
# this file, which it cannot see.
FRONTEND_ORIGINS = "http://localhost:9990"

# Where the client is, used to build the link an invitation travels in. The
# link points at the client rather than at this Worker on purpose: a link that
# acted on GET would be spent by the first mail scanner that opened it.
#
# Defaults to the Worker's own origin, which is right locally and wrong the
# moment the client is deployed anywhere else.
PORTAL_BASE_URL = "http://localhost:9990"

# "Lax" for ordinary local work. "None" only over HTTPS.
AUTH_COOKIE_SAME_SITE = "Lax"

# Optional. Defaults to 5; an integer from 1 to 20.
# APPLICANT_SIGNUP_TOKEN_ATTEMPT_COUNT = "5"

# --- Rate limiting ----------------------------------------------------------

# The limits themselves are NOT here. Each one is a binding in wrangler.jsonc,
# because the platform's limiter takes its limit and period from configuration
# rather than from the call. `npm run check:rate-limits` fails if the bindings
# there and the policy in src/services/rate-limit/policy.ts ever disagree.
#
# Locally none of it is needed: with ENVIRONMENT unset the Worker counts in
# process, which behaves the same and protects nothing beyond one isolate.
#
# The one variable that does live here turns counting off, and exists for test
# runs. The end-to-end suite passes it on the command line because that suite
# signs in dozens of times in three minutes — a usage pattern no real limit
# should be widened to accommodate.
#
# Refused outright when ENVIRONMENT is production: the Worker fails to start
# rather than serving unprotected, and `npm run check:rate-limits` refuses it in
# the deployed configuration too.
# RATE_LIMIT_DISABLED = "true"

# --- First administrator ----------------------------------------------------

# Used once, by the bootstrap route, to promote the first super administrator.
# Remove both as soon as that has been done — see
# docs/first-super-admin-bootstrap.md.
FIRST_SUPER_ADMIN_EMAIL = ""
FIRST_SUPER_ADMIN_SECRET = ""

# --- Document storage -------------------------------------------------------

# Only read when ENVIRONMENT is something other than local.
#
# Deployed, the browser sends each document straight to the bucket using a URL
# this Worker signs, so these are the credentials for a real bucket and the
# Worker never handles the bytes. Locally none of this is needed: the bytes come
# to the Worker and it writes them to the STORAGE binding, which the development
# runtime provides with no account feature and no keys. The client cannot tell
# the two apart — only the host in the upload URL differs.
#
# Set ENVIRONMENT to develop without these and the evidence screen refuses with
# "R2 signing configuration is required." rather than accepting documents the
# Worker cannot durably keep.
#
# Use bucket-scoped credentials, never an account-wide token.
# R2_ACCOUNT_ID = ""
# R2_BUCKET_NAME = ""
# R2_ACCESS_KEY_ID = ""
# R2_SECRET_ACCESS_KEY = ""

# --- Notification delivery --------------------------------------------------

# Only read when ENVIRONMENT is develop or production.
#
# Locally the one-time code is printed to the Worker's log on a line marked
# DEV_EMAIL, so signup works with nothing configured. A deployed environment
# must never do that — it would write live one-time codes into logs — so if it
# is told it is deployed and these are missing, signup refuses rather than
# falling back to printing them.
#
# PINGRAM_NOTIFICATION_TYPE is the provider's own identifier for the template
# the message is sent as. It is required by the provider, not by the programme,
# and nothing outside transports/pingram.ts knows it exists.
#
# Provision both as secrets in a deployed environment — `wrangler secret put` —
# never as vars in wrangler.jsonc, which is checked in.
# PINGRAM_API_KEY = ""
# PINGRAM_NOTIFICATION_TYPE = ""
