{
  "name": "seb-dev-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "local": "SEB_API_URL=http://localhost:9999 vite dev --port 9990",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "generate-routes": "tsr generate",
    "codegen": "graphql-codegen --config codegen.ts && node scripts/annotate-pure.mjs src/graphql/generated/operations.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.ts\" \"!src/routeTree.gen.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.ts\" \"!src/routeTree.gen.ts\""
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.0",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-cli": "^1.167.32",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "graphql": "^17.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
